# Server Port
PORT=8080

# MongoDB Connection String (e.g., MongoDB Atlas URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/authentication?retryWrites=true&w=majority

# JWT Secret Key for signing auth tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS configuration (optional, defaults to wildcard or frontend domain)
CLIENT_URL=http://localhost:5173
